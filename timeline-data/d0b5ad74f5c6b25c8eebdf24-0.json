e-icon\" data-icon=\"check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.05\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"m5 12 4.5 4.5L19 7\"></path></svg><span data-copy-message=\"true\"></span></span></span></span><button type=\"button\" hidden=\"\" aria-label=\"Share link\" title=\"Share link\" class=\"icon-control icon-control--toolbar share-controls__control share-controls__native\"><svg class=\"site-icon\" data-icon=\"share\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.05\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 16V4m-4.5 4L11.3 4a1 1 0 0 1 1.4 0l3.8 4M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5\"></path></svg></button><span class=\"share-controls__status share-controls__status--visually-hidden\" role=\"status\"></span></div></div></div></div></article>","2026-11-10-robert-pirsig-rationality":"<article class=\"rabbit-timeline__entry\" data-content-id=\"2026-11-10-robert-pirsig-rationality\" data-type=\"quote\"><button type=\"button\" class=\"rabbit-timeline__icon rabbit-timeline__icon--link\" data-filter-type=\"quote\" aria-label=\"Show quotes\" title=\"Show quotes\"><svg class=\"site-icon\" data-icon=\"quote\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.05\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M5 11V6h6v5c0 4-2 6-5 7M14 11V6h6v5c0 4-2 6-5 7\"></path></svg></button><div class=\"rabbit-timeline__meta\"><time dateTime=\"2026-11-10T17:24:00\">November 10th, 2026</time></div><div class=\"rabbit-timeline__preview\"><blockquote>\n<p>If a factory is torn down but the rationality which produced it is left standing, then that rationality will simply produce another factory. If a revolution destroys a government, but the systematic patterns of thought that produced that government are left intact, then those patterns will repeat themselves. . . . There’s so much talk about the system. And so little understanding.</p>\n<p class=\"quote-attribution\">—Robert Pirsig, <em>Zen and the Art of Motorcycle Maintenance</em></p>\n</blockquote></div><div class=\"rabbit-timeline__entry-actions\"><div class=\"share-controls\" data-compact=\"true\" data-menu-placement=\"below\" data-share-url=\"https://traceintime.com/posts/2026-11-10-robert-pirsig-rationality/\" role=\"group\" aria-label=\"Share this post\"><a href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ftraceintime.com%2Fshare%2F2026-11-10-robert-pirsig-rationality%2F\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Share on X\" title=\"Share on X\" class=\"icon-control icon-control--toolbar share-controls__control\"><svg class=\"site-icon\" data-icon=\"socialX\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.05\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 4 20 20M20 4l-7 7M4 20l7-7M4 4h4l12 16h-4z\"></path></svg></a><a href=\"https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Ftraceintime.com%2Fposts%2F2026-11-10-robert-pirsig-rationality%2F\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Share on LinkedIn\" title=\"Share on LinkedIn\" class=\"icon-control icon-control--toolbar share-controls__control\"><svg class=\"site-icon\" data-icon=\"linkedin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.05\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect><path d=\"M7.5 10v7M7.5 7h.01M11.5 17v-7m0 3c0-4 5-4 5 0v4\"></path></svg></a><div class=\"share-controls__instagram\"><button type=\"button\" aria-label=\"Instagram\" title=\"Instagram options\" aria-expanded=\"false\" aria-controls=\"_card-5-R_54_-instagram\" class=\"icon-control icon-c